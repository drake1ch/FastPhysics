#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SMML_VERSION_MAJOR, SMML_VERSION_MINOR, SMML_VERSION_PATCH, 0
 PRODUCTVERSION SMML_VERSION_MAJOR, SMML_VERSION_MINOR, SMML_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SM Mod Loader - loads Scrap Mechanic DLL mods from Release\DLLModules"
            VALUE "FileVersion", SMML_VERSION_STRING
            VALUE "InternalName", "SMModLoader"
            VALUE "OriginalFilename", "SMModLoader.dll"
            VALUE "ProductName", "SM Mod Loader"
            VALUE "ProductVersion", SMML_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
