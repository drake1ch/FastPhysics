#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FP_VERSION_MAJOR, FP_VERSION_MINOR, FP_VERSION_PATCH, 0
 PRODUCTVERSION FP_VERSION_MAJOR, FP_VERSION_MINOR, FP_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FastPhysics - Scrap Mechanic mod"
            VALUE "FileVersion", FP_VERSION_STRING
            VALUE "InternalName", "FastPhysics"
            VALUE "OriginalFilename", "FastPhysics.dll"
            VALUE "ProductName", "FastPhysics"
            VALUE "ProductVersion", FP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
